pkgname=baski
pkgver=0.1.0
pkgrel=1
pkgdesc='Print anything on a Canon E410, one page per job, with guided two-sided printing'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal' 'cups' 'poppler' 'qpdf'
         'imagemagick' 'libnotify')
optdepends=('cnijfilter-e400series: the Canon driver that renders the pages (AUR)'
            'libreoffice-fresh: open Word, Excel, PowerPoint and LibreOffice files'
            'libcanberra: sounds when the fronts or the whole job are done')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/baski "$pkgdir/usr/bin/baski"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/baski.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/baski.svg"
  install -Dm644 "$startdir/baski.desktop" "$pkgdir/usr/share/applications/baski.desktop"
}
