pkgname=pritingo
pkgver=0.2.1
pkgrel=1
pkgdesc='Print on Canon PIXMA E400-series printers one page per job, with guided two-sided printing, and scan to PDF'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal' 'cups' 'poppler' 'qpdf'
         'imagemagick' 'libnotify')
optdepends=('cnijfilter-e400series: the Canon driver that renders the pages (AUR)'
            'libreoffice-fresh: open Word, Excel, PowerPoint and LibreOffice files'
            'libcanberra: sounds when the fronts or the whole job are done'
            'sane: scan from the printer'\''s glass to a PDF or a copy')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/pritingo "$pkgdir/usr/bin/pritingo"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/pritingo.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/pritingo.svg"
  install -Dm644 "$startdir/pritingo.desktop" "$pkgdir/usr/share/applications/pritingo.desktop"
}
